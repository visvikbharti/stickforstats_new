[flake8]
max-line-length = 120
exclude =
    migrations,
    __pycache__,
    .git,
    .venv,
    venv,
    node_modules,
    static,
    media
extend-ignore =
    # line too long — let Black handle formatting
    E501,
    # whitespace before ':' — conflicts with Black
    E203,
    # line break before binary operator — conflicts with Black
    W503,
    # too many blank lines — cosmetic, let Black handle
    E303,
    # module level import not at top of file — many intentional (Django settings, conditional imports)
    E402,
    # comparison to True/False — sometimes intentional for explicit boolean checks
    E712,
    # bare except — intentional catch-all handlers in statistical computation code
    E722,
    # lambda assignment — acceptable in statistical helper code
    E731,
    # ambiguous variable name — statistical convention (e.g., 'l' for lambda)
    E741,
    # blank line contains whitespace — cosmetic
    W293,
    # blank line at end of file — cosmetic
    W391
per-file-ignores =
    # imported but unused in __init__.py (re-exports)
    */__init__.py:F401
    # module level import not at top of file (conditional imports)
    */settings.py:E402
    # syntax errors in broken/stub files
    api/v1/audit_views_broken.py:E999
    sqc_analysis/consumers.py:E999
    # undefined names — missing imports in service stubs
    api/v1/regression_views.py:F821
    confidence_intervals/services/bootstrap_service.py:F821
    confidence_intervals/services/interval_service.py:F821
    sqc_analysis/api/views.py:F821
