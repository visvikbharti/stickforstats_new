# StickForStats Production Environment Configuration
# Copy this file to .env and update the values for your deployment

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
ENVIRONMENT=production
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
# IMPORTANT: Generate a new secret key for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-this
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Aliases used by docker-compose (mapped to DJANGO_* inside the container)
SECRET_KEY=your-secret-key-here-change-this
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# =============================================================================
# DATABASE SETTINGS (PostgreSQL)
# =============================================================================
DB_NAME=stickforstats
DB_USER=stickforstats
DB_PASSWORD=your-secure-database-password
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# =============================================================================
# API URLS
# =============================================================================
API_URL=https://yourdomain.com/api
WS_URL=wss://yourdomain.com/ws

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Used by docker-compose
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Used directly by Django settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRATION=3600

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# WORKER SETTINGS (Celery)
# =============================================================================
WORKER_CONCURRENCY=4
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
# Set to False for production (True runs tasks synchronously for dev)
CELERY_TASK_ALWAYS_EAGER=False

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
ENABLE_METRICS=true
ENABLE_PROFILING=false
ENABLE_ANALYTICS=false

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password
GRAFANA_ROOT_URL=https://monitoring.yourdomain.com

# Prometheus
PROMETHEUS_PORT=9090

# =============================================================================
# COMPLIANCE AND AUDIT SETTINGS
# =============================================================================
FDA_COMPLIANCE_MODE=true
AUDIT_LOG_RETENTION_DAYS=2555

# =============================================================================
# PORT SETTINGS
# =============================================================================
FRONTEND_PORT=80
BACKEND_PORT=8000

# =============================================================================
# BACKUP SETTINGS
# =============================================================================
# Cron schedule for database backups (default: 2 AM daily)
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# PLATFORM SETTINGS (Optional)
# =============================================================================
FRONTEND_URL=https://yourdomain.com
STICKFORSTATS_TIER_ENFORCEMENT=false
STICKFORSTATS_USAGE_METERING=false

# =============================================================================
# STRIPE BILLING (Optional)
# =============================================================================
# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# =============================================================================
# S3/MINIO OBJECT STORAGE (Optional)
# =============================================================================
# S3_BUCKET_NAME=stickforstats-files
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION_NAME=us-east-1

# =============================================================================
# AI ADVISOR SETTINGS (Optional)
# =============================================================================
# ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# ERROR TRACKING (Optional)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn

# =============================================================================
# SSL/TLS SETTINGS (for production)
# =============================================================================
# SSL_CERTIFICATE=/path/to/cert.pem
# SSL_CERTIFICATE_KEY=/path/to/key.pem
