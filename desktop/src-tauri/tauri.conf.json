{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "cd ../frontend && NODE_OPTIONS=\"--max-old-space-size=4096\" npx react-scripts build",
    "beforeDevCommand": "cd ../frontend && npm start",
    "devPath": "http://localhost:3000",
    "distDir": "../frontend/build"
  },
  "package": {
    "productName": "StickForStats",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "scope": ["$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**"]
      },
      "clipboard": {
        "all": true,
        "writeText": true,
        "readText": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://api.stickforstats.com/**", "http://localhost:8000/**"]
      },
      "notification": {
        "all": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "setTitle": true,
        "setSize": true,
        "setMinSize": true,
        "setPosition": true,
        "center": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "Copyright 2026 StickForStats",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.stickforstats.desktop",
      "longDescription": "StickForStats is a comprehensive statistical analysis platform with Guardian Statistical Protection, SQS manuscript quality scoring, and AI-powered autonomous analysis.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null,
        "minimumSystemVersion": "10.15"
      },
      "resources": [],
      "shortDescription": "Statistical Analysis Platform with Guardian Protection",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.stickforstats.com http://localhost:8000 https://api.anthropic.com; img-src 'self' data: blob:; font-src 'self' data:"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.stickforstats.com/desktop/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    },
    "windows": [
      {
        "title": "StickForStats — Statistical Analysis Platform",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ]
  }
}
